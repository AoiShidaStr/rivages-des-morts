# Copier ce fichier en .env pour changer les réglages de docker-compose.yml.

# Port de la machine où le jeu répond (http://localhost:8080 par défaut).
PORT=8080

# --- Sur Internet (tunnel ou VPS) ---------------------------------------------------------------
# Seuls ceux qui ont ce code peuvent créer un compte. Laisser vide : tout le monde peut.
CODE_INVITATION=
# Derrière le tunnel ou Caddy : 1, pour que le serveur voie l'adresse de chaque joueur (le frein aux essais de
# mot de passe en dépend).
PROXY=0
# 127.0.0.1 : le port 8080 ne répond plus qu'à cette machine (les autres passent par le tunnel ou Caddy).
HOTE=0.0.0.0
# Sur un VPS : le nom de domaine qui pointe vers lui (Caddy en tire le certificat HTTPS).
DOMAINE=
