{
  "name": "rivages-des-morts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p server && vite build && npm run serveur:build",
    "serveur": "npm run serveur:build && node --disable-warning=ExperimentalWarning dist-server/serveur.js",
    "serveur:build": "vite build --ssr server/serveur.ts --outDir dist-server --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p server",
    "sprites": "node tools/detourer.mjs",
    "planches": "node tools/planches.mjs",
    "sols": "node tools/sols.mjs",
    "carte": "node tools/carte.mjs",
    "zones": "node tools/zones-de-marche.mjs",
    "editeur": "vite --open /editeur.html",
    "decors": "node tools/decors.mjs",
    "nettoyer": "node tools/nettoyer.mjs",
    "objets": "node tools/collection-objets.mjs",
    "icones": "node tools/icones.mjs",
    "cadres": "node tools/cadres.mjs",
    "icones-pixel": "node tools/icones-pixel.mjs",
    "vfx": "node tools/vfx.mjs",
    "vfx-ia": "node tools/vfx-ia.mjs",
    "prompts-2d": "node tools/prompts-2d.mjs",
    "prompts-vfx": "node tools/prompts-vfx.mjs",
    "perso-test": "node tools/perso-test.mjs",
    "equilibrage": "node tools/equilibrage.mjs",
    "dps": "node tools/equilibrage.mjs --mode dps",
    "voies": "node tools/voies.mjs",
    "gravures": "node tools/gravures.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "trystero": "^0.25.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
